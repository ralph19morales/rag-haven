# Copy this file to ".env" and edit as needed. All values are optional;
# the defaults in ragmed/config.py apply when a variable is unset.

# --- Embeddings (local, no API key needed) ---
# Options: BAAI/bge-small-en-v1.5 (fast) | bge-base (default) | bge-large (best)
# EMBED_MODEL=BAAI/bge-base-en-v1.5

# --- LLM via vLLM (OpenAI-compatible API) ---
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=QuantTrio/Qwen3.6-27B-AWQ
# Qwen3 loops on greedy decode — do not set temperature to 0.
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.95
# LLM_TOP_K=20
# LLM_MAX_TOKENS=1024
# Client timeout in seconds. ~14 tok/s measured on a 24GB card, so a
# 1024-token answer can take over a minute.
# LLM_TIMEOUT=180
# Qwen3.6 is a reasoning model; leave this off for grounded retrieval so it
# doesn't burn max_tokens on chain-of-thought before answering.
# LLM_ENABLE_THINKING=false
# Fixed seed for the calls that FEED RETRIEVAL (HyDE draft, follow-up rewrite),
# not for the answer. Without it, sampling makes the retrieved passages random:
# asking one unchanged question three times, only 2-3 of its 10 chunks repeated.
# Negative disables.
# LLM_SEED=1729

# --- Local model loading ---
# Skip Hugging Face Hub revalidation when loading the embedder and reranker.
# They are already cached on disk, but sentence-transformers phones home anyway:
# measured 15.4s of model loading per process, of which ~10s was network. Set
# false only when you need to DOWNLOAD a model you have not cached yet.
# HF_OFFLINE=true

# Removes the Hugging Face Hub rate-limit warning when the vLLM container
# pulls model weights. Set in the environment/shell that runs `docker run`,
# not read by Haven itself.
# HF_TOKEN=

# --- Retrieval tuning ---
# TOP_K=6
# CANDIDATE_K=25
# Most chunks any ONE document may take in the top-K (0 disables the cap).
# Stops a landmark case from filling the context with itself.
# MAX_CHUNKS_PER_SOURCE=3
# How many of the FUSED top hits are guaranteed to survive reranking. The
# cross-encoder is weak on terse statutory text against a lay narrative: it once
# demoted the controlling statute from rank 3 to rank 17, and the answer
# inverted the law. Measured knee of the curve over 7 questions; 0 disables.
# RERANK_PROTECT_TOP=4
# Most chunks any one corpus FAMILY (lawphil/jurisprudence/doh/prc/billing) may
# take in the top-K. A per-FILE cap doesn't stop one KIND of authority owning
# the context — case law held 4 of 6 slots across three different case files,
# leaving no room for a statute and its IRR to answer together. 0 disables.
# MAX_CHUNKS_PER_FAMILY=2
# DENSE_WEIGHT=0.6
# LEXICAL_WEIGHT=0.4

# HyDE — bridges lay-worded questions to formal statutory text by drafting a
# short hypothetical answer and retrieving with that too.
#   off | auto (default, only when a question retrieves poorly) | always
# HYDE_MODE=auto
# Auto trigger: best RAW cosine similarity below this. Measured on this corpus,
# well-posed questions scored 0.696-0.789 and lay-narrative ones 0.594-0.653.
# Re-measure if you change the embedding model or the corpus.
# HYDE_MIN_SIM=0.68
# Second trigger, for COMPOUND questions. Similarity over a whole question is a
# maximum, so one well-matched clause hides the rest: "can we refuse to release
# the body ... who can we collect from, and is there a deadline?" scored 0.736
# and HyDE stayed off, so the estate-claim half went unretrieved. Each ASK is
# therefore scored on its own and HyDE fires when the worst falls below this.
# Measured: asks this corpus answers 0.721-0.783, asks it does not 0.605-0.678.
# HYDE_CLAUSE_MIN_SIM=0.70
# Draft length cap. This is the most expensive single step in retrieval — the
# draft is generated serially before retrieval can finish — but the prompt, not
# this cap, now sets the length: drafts come back at ~95 tokens on their own.
# HYDE_MAX_TOKENS=128
# Cost when it fires: one extra LLM call (~4-5s; was ~10.5s at a 200-token cap).

# --- Chunking ---
# CHUNK_SIZE=1100
# CHUNK_OVERLAP=150
