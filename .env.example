# Copy this file to ".env" and edit as needed. All values are optional;
# the defaults in ragmed/config.py apply when a variable is unset.

# --- Embeddings (local, no API key needed) ---
# Options: BAAI/bge-small-en-v1.5 (fast) | bge-base (default) | bge-large (best)
# EMBED_MODEL=BAAI/bge-base-en-v1.5

# --- LLM via Ollama ---
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_TEMPERATURE=0.1
# LLM_NUM_CTX=8192

# --- Retrieval tuning ---
# TOP_K=6
# CANDIDATE_K=25
# Most chunks any ONE document may take in the top-K (0 disables the cap).
# Stops a landmark case from filling the context with itself.
# MAX_CHUNKS_PER_SOURCE=3
# DENSE_WEIGHT=0.6
# LEXICAL_WEIGHT=0.4

# HyDE — bridges lay-worded questions to formal statutory text by drafting a
# short hypothetical answer and retrieving with that too.
#   off | auto (default, only when a question retrieves poorly) | always
# HYDE_MODE=auto
# Auto trigger: best RAW cosine similarity below this. Measured on this corpus,
# well-posed questions scored 0.696-0.789 and lay-narrative ones 0.594-0.653.
# Re-measure if you change the embedding model or the corpus.
# HYDE_MIN_SIM=0.68
# Second trigger, for COMPOUND questions. Similarity over a whole question is a
# maximum, so one well-matched clause hides the rest: "can we refuse to release
# the body ... who can we collect from, and is there a deadline?" scored 0.736
# and HyDE stayed off, so the estate-claim half went unretrieved. Each ASK is
# therefore scored on its own and HyDE fires when the worst falls below this.
# Measured: asks this corpus answers 0.721-0.783, asks it does not 0.605-0.678.
# HYDE_CLAUSE_MIN_SIM=0.70
# HYDE_MAX_TOKENS=200
# Cost when it fires: one extra LLM call (~10-17s on local CPU inference).

# --- Chunking ---
# CHUNK_SIZE=1100
# CHUNK_OVERLAP=150
